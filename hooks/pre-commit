#!/usr/bin/env bash
#
# pre-commit hook — auto-bump patch version in VERSION file.
#
# Reads the current VERSION, increments the patch number,
# writes it back, and stages the file so it's included in the commit.
#
# To skip the bump (e.g. for merge commits), use:
#   git commit --no-verify
#

set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
VERSION_FILE="$ROOT/VERSION"

if [[ ! -f "$VERSION_FILE" ]]; then
  echo "VERSION file not found, skipping version bump."
  exit 0
fi

CURRENT="$(cat "$VERSION_FILE" | tr -d '[:space:]')"

# Strip pre-release suffix for calculation
BASE="${CURRENT%%-*}"
IFS='.' read -r MAJOR MINOR PATCH <<< "$BASE"

PATCH=$((PATCH + 1))
NEXT="${MAJOR}.${MINOR}.${PATCH}"

echo "$NEXT" > "$VERSION_FILE"
git add "$VERSION_FILE"

echo "Version bumped: $CURRENT -> $NEXT"
