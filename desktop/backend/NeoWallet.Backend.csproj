<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>NeoWallet.Backend</RootNamespace>
    <AssemblyName>NeoWallet.Backend</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\SUS.EOS.NeoWallet\SUS.EOS.Sharp\SUS.EOS.Sharp.csproj" />
    <ProjectReference Include="..\..\SUS.EOS.NeoWallet\SUS.EOS.EosioSigningRequest\SUS.EOS.EosioSigningRequest.csproj" />
  </ItemGroup>

  <!-- Embed the React frontend build (desktop/app/dist) as wwwroot. -->
  <!-- Run 'npm run build' in desktop/app before building the backend. -->
  <ItemGroup Condition="Exists('..\app\dist\index.html')">
    <Content Include="..\app\dist\**" LinkBase="wwwroot" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
