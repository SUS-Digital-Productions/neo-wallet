{
  "$schema": "https://raw.githubusercontent.com/nicegui/tauri/v2/crates/tauri-utils/schema.json",
  "productName": "Neo Wallet",
  "version": "0.1.0",
  "identifier": "com.sus.neowallet",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Neo Wallet",
        "width": 1024,
        "height": 768,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    },
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["esr"]
      },
      "mobile": [
        {
          "scheme": ["esr"],
          "appLink": false
        }
      ]
    }
  }
}
